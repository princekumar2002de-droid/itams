# =============================================================================
#  Copy this file to  docker/.env  and edit the values you want to override.
#  The .env file is gitignored — nothing here reaches version control.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=itams
POSTGRES_USER=itams
POSTGRES_PASSWORD=itams
POSTGRES_HOST_PORT=5432

# ── Backend (Spring Boot) ───────────────────────────────────────────────────
# The backend Dockerfile sets SPRING_PROFILES_ACTIVE=prod by default.
# For local dev with the DevBootstrap demo users, set it to "default" here.
SPRING_PROFILES_ACTIVE=default
BACKEND_HOST_PORT=8080

# ── JWT (required — backend fails to start if JWT_SECRET is empty) ─────────
# Any string of at least 32 characters (256 bits) works for HS256.
# Generate a fresh one with:   openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=dev-only-secret-please-replace-me-with-openssl-rand-base64-48
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=itams

# ── Bootstrap demo users (only created in non-prod profiles) ───────────────
# The three demo users (admin / itmanager / employee) get this password.
# Change it before you demo the project to anyone else.
BOOTSTRAP_DEMO_PASSWORD=changeme

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_HOST_PORT=3000

# ── pgAdmin (optional — enable with `docker compose --profile tools up`) ────
PGADMIN_EMAIL=admin@itams.local
PGADMIN_PASSWORD=admin
PGADMIN_HOST_PORT=5050
